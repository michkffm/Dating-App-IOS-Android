# Copy to .env locally; never commit the actual file or use exposed values.
PORT=3407
# When testing the Expo web build, give the absolute export directory below.
# HEARTPULSE_WEB_DIR=
# DATABASE_URL=   # Managed PostgreSQL URL with sslmode=verify-full.
# APP_ORIGINS=    # Exact HTTPS origins. Multiple entries separated by commas.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# REGISTRATION_ENABLED=false
# Transactional email for verified accounts (sample keys only):
# SMTP_URL=
# MAIL_FROM=
# PUBLIC_APP_ORIGIN=
# On Render Free, leave SMTP_URL unset and use Brevo's HTTPS API:
# BREVO_API_KEY=
# ACCOUNT_MAIL_DAILY_LIMIT=100
# Optional: comma-separated, authorized pilot inboxes (max 10); private env only.
# REGISTRATION_TEST_EMAILS=
